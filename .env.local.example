# Copy to .env.local and fill in. Vite only exposes VITE_* variables to the
# browser; everything else here stays on your machine.

# --- Supabase (Database + Auth) ---
# Project URL and anon (public) key from Supabase -> Project Settings -> API.
# The anon key is safe to ship to the browser; the service-role key never is.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# --- n8n (chat assistant + quick-add) --- see n8n/README.md
# Your n8n instance, no trailing slash. Local docker: http://localhost:5678
VITE_N8N_BASE_URL=https://n8n.example.com
# Must match the Header Auth credential value on the Webhook nodes. This is a
# nuisance filter only: it ends up in the JS bundle. The real check is the
# user's Supabase session token, which the workflows verify on every call.
VITE_N8N_SHARED_SECRET=
# Optional overrides if your webhook paths differ from the workflow JSON
# VITE_N8N_CHAT_WEBHOOK_URL=
# VITE_N8N_CONFIRM_WEBHOOK_URL=
# VITE_N8N_QUICKADD_WEBHOOK_URL=

# --- Local-only tooling (not read by the app) ---
# n8n public API key, used to push workflow changes with scripts, never in the browser.
# N8N_API_URL=https://n8n.example.com/
# N8N_API_KEY=
# Direct Postgres URL for applying supabase/migrations to the cloud project.
# Use the session pooler host (IPv4); the direct db.<ref> host is IPv6-only.
# CLOUD_SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
