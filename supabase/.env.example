# Copy to .env and fill in real values before `docker compose up`.
# Generate JWT_SECRET / ANON_KEY / SERVICE_ROLE_KEY with:
#   node scripts/generate-jwt-keys.mjs
# See README.md for the full setup walkthrough.

# --- Postgres ---
POSTGRES_PASSWORD=
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# --- JWT (shared by auth/rest/realtime) ---
JWT_SECRET=
JWT_EXPIRY=3600
ANON_KEY=
SERVICE_ROLE_KEY=

# --- Realtime ---
# Must be at least 64 characters — generate with: openssl rand -base64 48
SECRET_KEY_BASE=

# --- URLs ---
# Local dev defaults below. In Phase 3, point these at the real domains
# (e.g. API_EXTERNAL_URL=https://budget-api.awesomate.ai) — nothing else
# in this compose file changes.
SITE_URL=http://localhost:5173
API_EXTERNAL_URL=http://localhost:8000
ADDITIONAL_REDIRECT_URLS=

# --- Kong ---
KONG_HTTP_PORT=8000
